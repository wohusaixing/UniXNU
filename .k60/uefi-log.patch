diff --git a/Platforms/Xiaomi/mondrianPkg/Drivers/XnuLogDxe/XnuLogDxe.c b/Platforms/Xiaomi/mondrianPkg/Drivers/XnuLogDxe/XnuLogDxe.c
new file mode 100644
index 0000000..157fb35
--- /dev/null
+++ b/Platforms/Xiaomi/mondrianPkg/Drivers/XnuLogDxe/XnuLogDxe.c
@@ -0,0 +1,200 @@
+/** @file
+  K60 bring-up: copy the XNU panic console mirror (pong_ramoops_console writes
+  the kernel console into the Android ramoops console zone at 0xA7000000 in
+  Linux persistent_ram format) into a file on the LOGFS FAT partition, which
+  Android mounts at /dev/logfs.  The next Android boot can then read the panic
+  text over adb without a screen, a camera or OCR.
+
+  Runs as a DXE driver as soon as a SimpleFileSystem is published (i.e. once
+  the vendor UFS stack, PartitionDxe and FatDxe have found the LOGFS volume).
+**/
+
+#include <Uefi.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PrintLib.h>
+#include <Library/DebugLib.h>
+#include <Protocol/SimpleFileSystem.h>
+#include <Guid/FileInfo.h>
+
+#define K60_RAMOOPS_BASE   0x00000000A7000000ULL
+#define K60_RAMOOPS_SIZE   0x00200000U
+#define K60_RAMOOPS_SIG    0x43474244U
+#define K60_DUMP_FILE      L"XnuLog.txt"
+#define K60_DUMP_LIMIT     (192 * 1024)
+
+typedef struct {
+  UINT32 Sig;
+  UINT32 Start;
+  UINT32 Size;
+} K60_RAMOOPS_HEADER;
+
+STATIC UINT8  mText[K60_DUMP_LIMIT];
+STATIC CHAR8  mHeader[160];
+
+STATIC
+UINTN
+K60CopyRamoops (
+  OUT UINT8  *Out,
+  IN  UINTN   OutCap
+  )
+{
+  volatile K60_RAMOOPS_HEADER  *Hdr;
+  UINT8                        *Data;
+  UINTN                         Cap;
+  UINTN                         Size;
+  UINTN                         Start;
+  UINTN                         Index;
+
+  Hdr = (volatile K60_RAMOOPS_HEADER *)(UINTN)K60_RAMOOPS_BASE;
+  if (Hdr->Sig != K60_RAMOOPS_SIG) {
+    return 0;
+  }
+
+  Cap   = K60_RAMOOPS_SIZE - sizeof (K60_RAMOOPS_HEADER);
+  Size  = Hdr->Size;
+  Start = Hdr->Start;
+  if ((Size == 0) || (Size > Cap)) {
+    return 0;
+  }
+  if (Start >= Cap) {
+    Start = 0;
+  }
+  if (Size > OutCap) {
+    Start = (Start + (Size - OutCap)) % Cap;
+    Size  = OutCap;
+  }
+
+  Data = (UINT8 *)(UINTN)(K60_RAMOOPS_BASE + sizeof (K60_RAMOOPS_HEADER));
+  for (Index = 0; Index < Size; Index++) {
+    Out[Index] = Data[(Start + Index) % Cap];
+  }
+  return Size;
+}
+
+STATIC
+EFI_STATUS
+K60WriteDump (
+  IN EFI_FILE_PROTOCOL  *Root,
+  IN UINTN               Size
+  )
+{
+  EFI_STATUS         Status;
+  EFI_FILE_PROTOCOL  *File;
+  UINTN               HeaderLen;
+  UINTN               Written;
+
+  Status = Root->Open (
+                   Root,
+                   &File,
+                   (CHAR16 *)K60_DUMP_FILE,
+                   EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE,
+                   0
+                   );
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  HeaderLen = AsciiSPrint (
+                mHeader,
+                sizeof (mHeader),
+                "K60 XNU log dump (UEFI) ramoops=0x%lx size=%lu\r\n----- BEGIN -----\r\n",
+                (UINT64)K60_RAMOOPS_BASE,
+                (UINT64)Size
+                );
+  Status = File->Write (File, &HeaderLen, mHeader);
+  if (!EFI_ERROR (Status) && (Size != 0)) {
+    Written = Size;
+    Status  = File->Write (File, &Written, mText);
+  }
+  if (!EFI_ERROR (Status)) {
+    HeaderLen = AsciiSPrint (mHeader, sizeof (mHeader), "\r\n----- END -----\r\n");
+    Status    = File->Write (File, &HeaderLen, mHeader);
+  }
+  File->Flush (File);
+  File->Close (File);
+  return Status;
+}
+
+EFI_STATUS
+EFIAPI
+XnuLogEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS                    Status;
+  EFI_HANDLE                   *Handles;
+  UINTN                         HandleCount;
+  UINTN                         Index;
+  UINTN                         Size;
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *SimpleFs;
warning: in the working copy of 'Platforms/Xiaomi/mondrianPkg/Drivers/XnuLogDxe/XnuLogDxe.inf', LF will be replaced by CRLF the next time Git touches it
+  EFI_FILE_PROTOCOL            *Root;
+  EFI_FILE_SYSTEM_INFO         *FsInfo;
+  UINTN                         InfoSize;
+  BOOLEAN                       Wrote;
+
+  Size = K60CopyRamoops (mText, sizeof (mText));
+  DEBUG ((DEBUG_ERROR, "XnuLog: ramoops dump %lu bytes\n", (UINT64)Size));
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleFileSystemProtocolGuid,
+                  NULL,
+                  &HandleCount,
+                  &Handles
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "XnuLog: no SimpleFileSystem: %r\n", Status));
+    return EFI_SUCCESS;
+  }
+
+  Wrote = FALSE;
+  for (Index = 0; Index < HandleCount; Index++) {
+    Status = gBS->HandleProtocol (Handles[Index], &gEfiSimpleFileSystemProtocolGuid, (VOID **)&SimpleFs);
+    if (EFI_ERROR (Status)) {
+      continue;
+    }
+    Status = SimpleFs->OpenVolume (SimpleFs, &Root);
+    if (EFI_ERROR (Status)) {
+      continue;
+    }
+
+    InfoSize = 0;
+    FsInfo   = NULL;
+    Status   = Root->GetInfo (Root, &gEfiFileSystemInfoGuid, &InfoSize, FsInfo);
+    if (Status == EFI_BUFFER_TOO_SMALL) {
+      FsInfo = AllocatePool (InfoSize);
+      if (FsInfo != NULL) {
+        Status = Root->GetInfo (Root, &gEfiFileSystemInfoGuid, &InfoSize, FsInfo);
+      }
+    } else {
+      Status = EFI_UNSUPPORTED;
+    }
+
+    if (!EFI_ERROR (Status) && (FsInfo != NULL)) {
+      DEBUG ((DEBUG_ERROR, "XnuLog: volume '%s'\n", FsInfo->VolumeLabel));
+      if (StrCmp (FsInfo->VolumeLabel, L"LOGFS") == 0) {
+        Status = K60WriteDump (Root, Size);
+        DEBUG ((DEBUG_ERROR, "XnuLog: write to %s -> %r\n", K60_DUMP_FILE, Status));
+        if (!EFI_ERROR (Status)) {
+          Wrote = TRUE;
+        }
+      }
+      FreePool (FsInfo);
+    }
+    Root->Close (Root);
+    if (Wrote) {
+      break;
+    }
+  }
+
+  FreePool (Handles);
+  if (!Wrote) {
+    DEBUG ((DEBUG_ERROR, "XnuLog: no LOGFS volume found\n"));
+  }
+  return EFI_SUCCESS;
+}
