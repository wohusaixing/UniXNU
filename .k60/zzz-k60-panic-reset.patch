+/* K60 bring-up: PSCI SYSTEM_RESET with the conduit the boot loader advertised. */
+static int
+k60_psci_uses_hvc(void)
+{
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size = 0;
+	static int cached = -1;
+
+	if (cached >= 0) {
+		return cached;
+	}
+	cached = 0;
+	if (SecureDTLookupEntry(0, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "psci-method", &prop, &size) == kSuccess &&
+	    size >= 3 && ((const char *)prop)[0] == 'h' && ((const char *)prop)[1] == 'v' &&
+	    ((const char *)prop)[2] == 'c') {
+		cached = 1;
+	}
+	return cached;
+}
+
+void
+PE_k60_reset_now(void)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL; /* PSCI SYSTEM_RESET */
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	if (k60_psci_uses_hvc()) {
+		__asm__ volatile ("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+	} else {
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+	}
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
